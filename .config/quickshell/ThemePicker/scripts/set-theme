#!/usr/bin/env bash

# Включаем строгий режим: скрипт упадет при любой ошибке или необъявленной переменной
set -euo pipefail

WALLPAPER_DIR="$HOME/Pictures/Wallpapers"
WALLPAPER_NAME="${1:-}" # Берем первый аргумент

# Проверяем наличие необходимых инструментов, чтобы падать с понятной ошибкой
for cmd in awww matugen; do
  if ! command -v "$cmd" >/dev/null 2>&1; then
    echo "Error: '$cmd' is not installed." >&2
    exit 1
  fi
done

WALLPAPER_PATH="$WALLPAPER_DIR/$WALLPAPER_NAME"

# Валидация имени: запрещаем path traversal (слэши и ".."),
# но разрешаем пробелы и юникод — реальные имена файлов бывают разными.
if [[ "$WALLPAPER_NAME" == */* || "$WALLPAPER_NAME" == *..* || -z "$WALLPAPER_NAME" ]]; then
  echo "Error: Invalid wallpaper name '$WALLPAPER_NAME'." >&2
  exit 1
fi

if [[ ! -f "$WALLPAPER_PATH" ]]; then
  echo "Error: File '$WALLPAPER_PATH' not found." >&2
  exit 1
fi

# 2. Генерация палитры
# Запускаем matugen. Он обновит colors.json согласно config.toml

matugen image "$WALLPAPER_PATH" --prefer saturation --type scheme-vibrant
# 1. Запуск анимации смены обоев (awww)
# transition-pos 0.5,0.5 означает старт из центра экрана
# Запускаем в фоне; ошибки фонового процесса не ловятся set -e,
# поэтому явно проверяем, что процесс стартовал.
awww img "$WALLPAPER_PATH" \
  --transition-type grow \
  --transition-pos 0.5,0.5 \
  --transition-duration 2.4 \
  --transition-fps 60 &
AWWW_PID=$!
sleep 0.2
if ! kill -0 "$AWWW_PID" 2>/dev/null; then
  echo "Error: awww failed to start." >&2
  exit 1
fi

