#!/usr/bin/env bash

set -euo pipefail

WALLPAPER_DIR="$HOME/Pictures/Wallpapers"
WALLPAPER_NAME="${1:-}"
WALLPAPER_PATH="$WALLPAPER_DIR/$WALLPAPER_NAME"

if [[ -z "$WALLPAPER_NAME" || "$WALLPAPER_NAME" == */* || "$WALLPAPER_NAME" == *..* ]]; then
  echo "Error: invalid wallpaper name." >&2
  exit 1
fi

if [[ ! -f "$WALLPAPER_PATH" ]]; then
  echo "Error: file not found." >&2
  exit 1
fi

awww img "$WALLPAPER_PATH" \
  --transition-type grow \
  --transition-pos 0.5,0.5 \
  --transition-duration 2.4 \
  --transition-fps 60

matugen image "$WALLPAPER_PATH" --prefer saturation --type scheme-smart

sudo "$HOME/.local/bin/update-sddm-wallpaper.sh" "$WALLPAPER_PATH"
