import os, re\
\
root = "/home/Rostislav/.config/quickshell"\
projects = ["Island", "NotificationCenter", "PowerMenu", "ThemePicker"]\
\
for proj in projects:\
    base = os.path.join(root, proj)\
    for dirpath, _, files in os.walk(base):\
        # пропу�скаем симлинк shared вну�три проекта\
        if os.path.basename(dirpath) == "shared" or "/shared/" in dirpath:\
            continue\
        for fn in files:\
            if not fn.endswith(".qml"):\
                continue\
            fp = os.path.join(dirpath, fn)\
            # относителу�ну�й пу�ту� от каталога у�айла до shared/theme вну�три проекта\
            rel = os.path.relpath(os.path.join(base, "shared", "theme"), dirpath)\
            rel = rel.replace(os.sep, "/")\
            # если rel нау�инаетсу� с "../"  � у�то у�естну�й относителу�ну�й пу�ту�\
            if rel.startswith(".."):\
                target = rel\
            else:\
                target = "./" + rel\
            with open(fp, "r", encoding="utf-8") as f:\
                content = f.read()\
            # замену�ем лу�бу�е су�у�еству�у�у�ие импорту� *shared/theme* на ву�у�исленну�й\
            new = re.sub(r'import "[^"]*shared/theme"', f'import "{target}"', content)\
            if new != content:\
                with open(fp, "w", encoding="utf-8") as f:\
                    f.write(new)\
                print(f"FIXED {fp} -> import \"{target}\"")\
print("DONE")\
EOF
python3 - <<'PYEOF'\
import os, re\
\
root = "/home/Rostislav/.config/quickshell"\
projects = ["Island", "NotificationCenter", "PowerMenu", "ThemePicker"]\
\
for proj in projects:\
    base = os.path.join(root, proj)\
    for dirpath, _, files in os.walk(base):\
        if os.path.basename(dirpath) == "shared" and os.path.islink(dirpath):\
            continue\
        for fn in files:\
            if not fn.endswith(".qml"):\
                continue\
            fp = os.path.join(dirpath, fn)\
            rel = os.path.relpath(os.path.join(base, "shared", "theme"), dirpath)\
            rel = rel.replace(os.sep, "/")\
            target = rel if rel.startswith("..") else "./" + rel\
            \
            with open(fp, "r", encoding="utf-8") as f:\
                lines = f.readlines()\
            changed = False\
            with open(fp, "w", encoding="utf-8") as f:\
                for line in lines:\
                    # Ѓ�амену�ем импорт, содержау�ий где-то shared/theme\
                    if 'shared' in line and 'theme' in line and 'import' in line:\
                        f.write(f'import "{target}"\n')\
                        changed = True\
                    else:\
                        f.write(line)\
            if changed:\
                print(f"FIXED {fp} -> import \"{target}\"")\
print("DONE")\
PYEOF
