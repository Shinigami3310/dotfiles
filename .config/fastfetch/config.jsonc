{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "padding": {
      "top": 2,
      "left": 2,
      "right": 2
    }
  },
  "display": {
    "separator": " ",
    "constants": [
      "\u001b[36m\u001b[85G│\u001b[0m"
    ],
    "key": {
      "width": 6
    },
    "color": {
      "keys": "cyan"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "\u001b[57G\u001b[1m\u001b[36m{1}\u001b[0m@\u001b[1m\u001b[36m{2}\u001b[0m"
    },
    "break",

    {
      "type": "custom",
      "format": "\u001b[36m╭─────────────────── OS ───────────────────╮\u001b[0m"
    },
    {
      "type": "os",
      "key": "│  ",
      "format": "{3}{$1}"
    },
    {
      "type": "kernel",
      "key": "│  ",
      "format": "{2}{$1}"
    },
    {
      "type": "packages",
      "key": "│ 󰏖 ",
      "format": "{all}{$1}"
    },
    {
      "type": "shell",
      "key": "│  ",
      "format": "{1}{$1}"
    },
    {
      "type": "custom",
      "format": "\u001b[36m├─────────────────── WM ───────────────────┤\u001b[0m"
    },
    {
      "type": "wm",
      "key": "│  ",
      "format": "{1}{$1}"
    },
    {
      "type": "lm",
      "key": "│ 󰧨 ",
      "format": "{1}{$1}"
    },
    {
      "type": "terminal",
      "key": "│  ",
      "format": "{1}{$1}"
    },
    {
      "type": "custom",
      "format": "\u001b[36m├─────────────────── PC ───────────────────┤\u001b[0m"
    },
    {
      "type": "cpu",
      "key": "│  ",
      "format": "{1}{$1}"
    },
    {
      "type": "gpu",
      "key": "│ 󰢮 ",
      "format": "{2}{$1}"
    },
    {
      "type": "memory",
      "key": "│  ",
      "format": "{1} / {2}{$1}"
    },
    {
      "type": "disk",
      "key": "│ 󰋊 ",
      "format": "{1} / {2}{$1}"
    },
    {
      "type": "custom",
      "format": "\u001b[36m├───────────────── Uptime ─────────────────┤\u001b[0m"
    },
    {
      "type": "uptime",
      "key": "│ 󰅐 ",
      "format": "{?1}{1} days, {?}{?2}{2} hours, {?}{3} mins{$1}"
    },
    {
      "type": "command",
      "key": "│ 󰃰 ",
      "text": "birth=$(stat -c %W /); today=$(date +%s); echo $(((today - birth) / 86400)) days",
      "format": "{1}{$1}"
    },
    {
      "type": "custom",
      "format": "\u001b[36m├───────────────── Colors ─────────────────┤\u001b[0m"
    },
    {
      "type": "custom",
      "key": "│  ",
      "format": "\u001b[31m██ \u001b[32m██ \u001b[33m██ \u001b[34m██ \u001b[35m██ \u001b[36m██ \u001b[37m██ {$1}"
    },
    {
      "type": "custom",
      "format": "\u001b[36m╰──────────────────────────────────────────╯\u001b[0m"
    }
  ]
}
